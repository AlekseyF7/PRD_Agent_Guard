{
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "execute", "resource": "*", "effect": "deny" }
  ],
  "policies": [
    { "action": "tool.use", "resource": "*", "effect": "deny" },
    { "action": "tool.use", "resource": "guard_guard_execute_command:*", "effect": "allow" }
  ],
  "mcp": {
    "servers": {
      "guard": {
        "type": "local",
        "command": ["REPLACE_WITH_ABSOLUTE_NODE_PATH", "REPLACE_WITH_ABSOLUTE_DIST_MAIN_JS", "REPLACE_WITH_ABSOLUTE_GUARD_CONFIG_JSON"],
        "codemode": false,
        "timeout": { "startup": 30000, "catalog": 10000, "execution": 600000 }
      }
    }
  }
}
